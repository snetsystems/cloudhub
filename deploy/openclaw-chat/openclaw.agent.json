{
  "id": "cloudhub-chat",
  "workspace": "/opt/cloudhub-openclaw/agents/cloudhub-chat",
  "model": {
    "primary": "ollama/gpt-oss:20b"
  },
  "sandbox": {
    "mode": "off",
    "scope": "session",
    "workspaceAccess": "ro"
  },
  "tools": {
    "allow": [
      "read",
      "sessions_list",
      "sessions_history",
      "session_status",
      "update_plan"
    ],
    "deny": [
      "group:runtime",
      "write",
      "edit",
      "apply_patch",
      "browser",
      "message",
      "web_fetch",
      "web_search"
    ],
    "elevated": {
      "enabled": false
    },
    "exec": {
      "mode": "deny"
    }
  }
}
