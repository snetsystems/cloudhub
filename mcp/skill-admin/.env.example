# Absolute directory agent workspaces live under. An agent's workspace is
# <root>/<agentId>, matching how CloudHub provisions them. Mount only this
# directory: nothing outside it is reachable.
SKILL_ADMIN_WORKSPACE_ROOT=/workspaces
MCP_SERVER_AUTH_TOKEN=
MCP_LISTEN_ADDR=:8080

# Host path mounted at SKILL_ADMIN_WORKSPACE_ROOT.
SKILL_ADMIN_WORKSPACE_SOURCE=
# The Gateway owns the workspaces; run as its uid to be able to remove them.
SKILL_ADMIN_UID=1000
SKILL_ADMIN_GID=1000
# CloudHub reaches this directly; keep it off the LAN.
SKILL_ADMIN_BIND=127.0.0.1
SKILL_ADMIN_PORT=8081
