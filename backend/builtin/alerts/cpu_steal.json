{
  "id": "cpu_steal",
  "name": "CPU Steal 알림",
  "description": "가상화 환경에서 hypervisor가 CPU를 가져가 게스트 성능이 저하될 때 알림",
  "category": "server-monitoring",
  "tags": ["cpu", "virtualization"],
  "database": "",
  "retentionPolicy": "",
  "measurement": "cpu",
  "field": "usage_steal",
  "trigger": "threshold",
  "taskType": "stream",
  "every": "30s",
  "occurrenceType": "consecutive",
  "occurrenceCount": 2,
  "occurrenceWindow": "5m",
  "pauseSeconds": 0,
  "notifyRecovery": true,
  "message": "{{ index .Tags \"host\" }} CPU Steal {{ .Level }} ({{ index .Fields \"usage_steal\" }}%)",
  "conditions": [
    { "level": "critical", "value": 20, "operator": "greater", "enabled": true },
    { "level": "warning",  "value": 5, "operator": "greater", "enabled": true },
    { "level": "info",     "value": 0, "operator": "greater", "enabled": false }
  ]
}
