{
  "id": "mem_usage",
  "name": "Memory 사용률 알림",
  "description": "호스트 메모리 사용률이 임계치를 초과하면 알림",
  "category": "server-monitoring",
  "tags": [
    "memory",
    "capacity"
  ],
  "taskType": "stream",
  "occurrenceType": "consecutive",
  "occurrenceCount": 2,
  "occurrenceWindow": "5m",
  "pauseSeconds": 0,
  "notifyRecovery": true,
  "message": "{{ index .Tags \"host\" }} Memory 사용률 {{ .Level }} ({{ index .Fields \"used_percent\" }}%)",
  "specs": [
    {
      "database": "",
      "retentionPolicy": "",
      "measurement": "mem",
      "field": "used_percent",
      "trigger": "threshold",
      "every": "30s",
      "conditions": [
        {
          "level": "critical",
          "value": 95,
          "operator": "greater",
          "enabled": true
        },
        {
          "level": "warning",
          "value": 80,
          "operator": "greater",
          "enabled": true
        },
        {
          "level": "info",
          "value": 0,
          "operator": "greater",
          "enabled": false
        }
      ]
    }
  ]
}
