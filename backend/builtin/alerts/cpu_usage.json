{
  "id": "cpu_usage",
  "name": "CPU 사용률 알림",
  "description": "호스트 CPU 사용률이 임계치를 초과하면 알림",
  "category": "server-monitoring",
  "tags": [
    "cpu",
    "performance"
  ],
  "taskType": "stream",
  "occurrenceType": "consecutive",
  "occurrenceCount": 2,
  "occurrenceWindow": "5m",
  "pauseSeconds": 0,
  "notifyRecovery": true,
  "message": "{{ index .Tags \"host\" }} CPU 사용률 {{ .Level }} ({{ index .Fields \"usage_percent\" }}%)",
  "specs": [
    {
      "database": "",
      "retentionPolicy": "",
      "measurement": "cpu",
      "field": "usage_percent",
      "trigger": "threshold",
      "every": "30s",
      "conditions": [
        {
          "level": "critical",
          "value": 90,
          "operator": "greater",
          "enabled": true
        },
        {
          "level": "warning",
          "value": 70,
          "operator": "greater",
          "enabled": true
        },
        {
          "level": "info",
          "value": 0,
          "operator": "greater",
          "enabled": false
        }
      ]
    }
  ]
}
