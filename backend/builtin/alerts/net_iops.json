{
  "id": "net_iops",
  "name": "Network IOPS 알림",
  "description": "초당 수신 패킷 수가 임계치를 초과하면 알림",
  "category": "server-monitoring",
  "tags": ["network", "throughput"],
  "database": "",
  "retentionPolicy": "",
  "measurement": "net",
  "field": "packets_recv",
  "derivative": {
    "enabled": true,
    "nonNegative": true,
    "unit": "1s"
  },
  "trigger": "threshold",
  "triggerOperator": "greater",
  "taskType": "stream",
  "every": "30s",
  "occurrenceType": "consecutive",
  "occurrenceCount": 2,
  "occurrenceWindow": "5m",
  "pauseSeconds": 0,
  "notifyRecovery": true,
  "message": "{{ index .Tags \"host\" }} Network IOPS {{ .Level }} ({{ index .Fields \"packets_recv\" }} pps)",
  "conditions": [
    { "level": "critical", "value": 100000, "enabled": true },
    { "level": "warning",  "value": 50000,  "enabled": true },
    { "level": "info",     "value": 0,      "enabled": false }
  ]
}
