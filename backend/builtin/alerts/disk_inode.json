{
  "id": "disk_inode",
  "name": "Disk Inode 사용률 알림",
  "description": "디스크 inode 사용률이 임계치를 초과하면 알림 (inodes_used / inodes_total * 100)",
  "category": "server-monitoring",
  "tags": ["disk", "capacity"],
  "database": "",
  "retentionPolicy": "",
  "measurement": "disk",
  "field": "inodes_used",
  "eval": {
    "expression": "float(\"inodes_used\") / float(\"inodes_total\") * 100.0",
    "as": "inodes_used_percent"
  },
  "trigger": "threshold",
  "triggerOperator": "greater",
  "taskType": "stream",
  "every": "30s",
  "occurrenceType": "consecutive",
  "occurrenceCount": 2,
  "occurrenceWindow": "5m",
  "pauseSeconds": 0,
  "notifyRecovery": true,
  "message": "{{ index .Tags \"host\" }} Inode 사용률 {{ .Level }} ({{ index .Fields \"inodes_used_percent\" }}%)",
  "conditions": [
    { "level": "critical", "value": 95, "enabled": true },
    { "level": "warning",  "value": 80, "enabled": true },
    { "level": "info",     "value": 0,  "enabled": false }
  ]
}
