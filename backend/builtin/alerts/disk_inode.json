{
  "id": "disk_inode",
  "name": "Disk Inode 사용률 알림",
  "description": "디스크 inode 사용률이 임계치를 초과하면 알림 (inodes_used / inodes_total * 100)",
  "category": "server-monitoring",
  "tags": [
    "disk",
    "capacity"
  ],
  "eval": {
    "expression": "float(\"inodes_used\") / float(\"inodes_total\") * 100.0",
    "as": "inodes_used_percent"
  },
  "taskType": "stream",
  "occurrenceType": "consecutive",
  "occurrenceCount": 2,
  "occurrenceWindow": "5m",
  "pauseSeconds": 0,
  "notifyRecovery": true,
  "message": "{{ index .Tags \"host\" }} Inode 사용률 {{ .Level }} ({{ index .Fields \"inodes_used_percent\" }}%)",
  "specs": [
    {
      "database": "",
      "retentionPolicy": "",
      "measurement": "disk",
      "field": "inodes_used",
      "trigger": "threshold",
      "every": "30s",
      "conditions": [
        {
          "level": "critical",
          "value": 95,
          "operator": "greater",
          "enabled": true
        },
        {
          "level": "warning",
          "value": 80,
          "operator": "greater",
          "enabled": true
        },
        {
          "level": "info",
          "value": 0,
          "operator": "greater",
          "enabled": false
        }
      ]
    }
  ]
}
