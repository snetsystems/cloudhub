{
  "id": "swap_mem",
  "name": "Swap Memory 사용률 알림",
  "description": "스왑 메모리 사용률이 임계치를 초과하면 알림 (스왑 발생 자체가 성능 저하 신호)",
  "category": "server-monitoring",
  "tags": [
    "memory",
    "swap"
  ],
  "taskType": "stream",
  "occurrenceType": "consecutive",
  "occurrenceCount": 2,
  "occurrenceWindow": "5m",
  "pauseSeconds": 0,
  "notifyRecovery": true,
  "message": "{{ index .Tags \"host\" }} Swap 사용률 {{ .Level }} ({{ index .Fields \"used_percent\" }}%)",
  "specs": [
    {
      "database": "",
      "retentionPolicy": "",
      "measurement": "swap",
      "field": "used_percent",
      "trigger": "threshold",
      "every": "30s",
      "conditions": [
        {
          "level": "critical",
          "value": 80,
          "operator": "greater",
          "enabled": true
        },
        {
          "level": "warning",
          "value": 50,
          "operator": "greater",
          "enabled": true
        },
        {
          "level": "info",
          "value": 0,
          "operator": "greater",
          "enabled": false
        }
      ]
    }
  ]
}
