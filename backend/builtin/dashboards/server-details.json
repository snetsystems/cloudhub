      "w": 48,
      "h": 8,
      "minW": 16,
      "minH": 4,
      "name": "CPU Usage",
      "queries": [
        {
          "query": "SELECT mean(\"usage_system\") AS \"system\", mean(\"usage_user\") AS \"user\", mean(\"usage_idle\") AS \"idle\", mean(\"usage_nice\") AS \"nice\", mean(\"usage_iowait\") AS \"iowait\", mean(\"usage_steal\") AS \"steal\", mean(\"usage_irq\") AS \"irq\", mean(\"usage_softirq\") AS \"softirq\" FROM \":db:\".\":rp:\".\"cpu\" WHERE \"host\" = :host: AND time > :dashboardTime: AND \"cpu\" = 'cpu-total' GROUP BY time(:interval:) FILL(null)",
          "label": "CPU Usage",
          "groupbys": [],
          "wheres": []
