      "x": 0,
      "y": 0,
      "w": 96,
      "h": 20,
      "minW": 48,
      "minH": 8,
      "name": "Server Info",
      "queries": [
        {
          "query": "SELECT last(\"total\")/1073741824 AS \"total_gib\", last(\"used\")/1073741824 AS \"used_gib\", last(\"free\")/1073741824 AS \"free_gib\", last(\"used_percent\") AS \"used_percent\", last(\"inodes_used_percent\") AS \"inode_used_percent\" FROM \":db:\".\":rp:\".\"disk\" WHERE time > :dashboardTime: AND \"host\"=:host: GROUP BY \"path\"",
          "label": "Disk Usage",
          "groupbys": [],
          "wheres": []
        }
      ],
      "type": "component"
    },
